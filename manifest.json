{
  "manifest_version": 3,
  "name": "TwoElve v6.1",
  "version": "6.0.46",
  "description": "AutomaÃƒÂ§ÃƒÂ£o para plataforma Elleven (DEV - com saudaÃƒÂ§ÃƒÂ£o automÃƒÂ¡tica)",
  "twoelveSaudacao": true,
  "twoelveBranch": "dev",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "paginas.js",
        "modalbase.js",
        "button.js",
        "config.js",
        "sidebar.js",
        "updater.js",
        "atalhos.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://erp.elo.net.br/*"
      ],
      "js": [
        "paginas.js",
        "visit.js",
        "messages.js",
        "forward.js",
        "auto.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "paginas.js",
        "utils.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://elonet.native-infinity.com.br/*"
      ],
      "js": [
        "paginas.js",
        "call.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TwoElve"
  },
  "background": {
    "service_worker": "background.js"
  }
}





