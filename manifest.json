{
  "manifest_version": 3,
  "name": "TwoElve v6.0",
  "version": "6.0.35",
  "description": "Automação para plataforma Elleven",
  "twoelveSaudacao": false,
  "twoelveBranch": "main",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "modalbase.js",
        "button.js",
        "config.js",
        "sidebar.js",
        "updater.js",
        "atalhos.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://erp.elo.net.br/*"
      ],
      "js": [
        "visit.js",
        "messages.js",
        "forward.js",
        "auto.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TwoElve"
  },
  "background": {
    "service_worker": "background.js"
  }
}
