{
  "manifest_version": 3,
  "name": "TwoElve v6.1",
  "version": "6.1.3",
  "description": "AutomaÃ§Ã£o para plataforma Elleven (DEV - com saudaÃ§Ã£o automÃ¡tica)",
  "twoelveSaudacao": true,
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://erp.elo.net.br/*"
      ],
      "js": [
        "modalbase.js",
        "button.js",
        "config.js",
        "sidebar.js",
        "visit.js",
        "messages.js",
        "forward.js",
        "auto.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://elonet.native-infinity.com.br/*"
      ],
      "js": [
        "call.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TwoElve"
  },
  "background": {
    "service_worker": "background.js"
  }
}
